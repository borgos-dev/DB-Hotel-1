digraph hotel_erd {
  graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.25, pad=0.3, fontname="Helvetica", label=<<B>Hotel Management database - entity-relationship diagram (crow's foot notation)</B>>, labelloc=t, fontsize=20];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#444444", dir=both, arrowsize=1.1, penwidth=1.2];
  amenity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2F6DB5"><FONT COLOR="white"><B>AMENITY</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>amenity_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(40)</FONT></TD></TR></TABLE>>];
  client [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E8B3D" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2E8B3D"><FONT COLOR="white"><B>CLIENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>client_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(120)</FONT></TD></TR></TABLE>>];
  invoice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7B3FB0" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#7B3FB0"><FONT COLOR="white"><B>INVOICE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>invoice_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">issue_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">ENUM</FONT></TD></TR></TABLE>>];
  invoice_line [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7B3FB0" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#7B3FB0"><FONT COLOR="white"><B>INVOICE_LINE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>invoice_line_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">invoice_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">line_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">tax_rate</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(5,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT">service_booking_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">line_subtotal</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">line_tax</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
  payment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7B3FB0" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#7B3FB0"><FONT COLOR="white"><B>PAYMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>payment_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">invoice_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">paid_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">method</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">ENUM</FONT></TD></TR></TABLE>>];
  reservation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E8B3D" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2E8B3D"><FONT COLOR="white"><B>RESERVATION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>reservation_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">client_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">check_in_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">check_out_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">nb_guests</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">cancelled_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATETIME</FONT></TD></TR></TABLE>>];
  reservation_room [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2E8B3D" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2E8B3D"><FONT COLOR="white"><B>RESERVATION_ROOM</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>reservation_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>room_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">nightly_price</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
  review [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#C0392B" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#C0392B"><FONT COLOR="white"><B>REVIEW</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>review_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">comment_text</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">review_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR></TABLE>>];
  room [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2F6DB5"><FONT COLOR="white"><B>ROOM</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>room_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">room_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">floor_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">room_type_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">max_capacity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">base_price</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">operational_status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">ENUM</FONT></TD></TR></TABLE>>];
  room_amenity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2F6DB5"><FONT COLOR="white"><B>ROOM_AMENITY</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>room_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>amenity_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT</FONT></TD></TR></TABLE>>];
  room_type [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6DB5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#2F6DB5"><FONT COLOR="white"><B>ROOM_TYPE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>room_type_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(255)</FONT></TD></TR></TABLE>>];
  service [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D9822B" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#D9822B"><FONT COLOR="white"><B>SERVICE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>service_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">slot_minutes</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">slot_capacity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR></TABLE>>];
  service_booking [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D9822B" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#D9822B"><FONT COLOR="white"><B>SERVICE_BOOKING</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>service_booking_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">reservation_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">service_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">slot_start</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">participants</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">ENUM</FONT></TD></TR></TABLE>>];
  service_opening_hours [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D9822B" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#D9822B"><FONT COLOR="white"><B>SERVICE_OPENING_HOURS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>service_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>day_of_week</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">open_time</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">close_time</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">TIME</FONT></TD></TR></TABLE>>];
  room_type -> room [arrowtail=teetee, arrowhead=crowodot, label="  classifies  "];
  room -> room_amenity [arrowtail=teetee, arrowhead=crowodot, label="  offers  "];
  amenity -> room_amenity [arrowtail=teetee, arrowhead=crowodot, label="  applies to  "];
  client -> reservation [arrowtail=teetee, arrowhead=crowodot, label="  makes  "];
  reservation -> reservation_room [arrowtail=teetee, arrowhead=crowtee, label="  covers  "];
  room -> reservation_room [arrowtail=teetee, arrowhead=crowodot, label="  is booked in  "];
  reservation -> service_booking [arrowtail=teetee, arrowhead=crowodot, label="  includes  "];
  service -> service_booking [arrowtail=teetee, arrowhead=crowodot, label="  is booked as  "];
  service -> service_opening_hours [arrowtail=teetee, arrowhead=crowodot, label="  opens (1-7 days)  "];
  reservation -> invoice [arrowtail=teetee, arrowhead=teeodot, label="  gives rise to  "];
  invoice -> invoice_line [arrowtail=teetee, arrowhead=crowtee, label="  is made of  "];
  service_booking -> invoice_line [arrowtail=teeodot, arrowhead=teeodot, label="  is billed by  "];
  invoice -> payment [arrowtail=teetee, arrowhead=crowodot, label="  is settled by  "];
  reservation -> review [arrowtail=teetee, arrowhead=teeodot, label="  is reviewed in  "];
  legend [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Cardinality (crow's foot)</B></TD></TR><TR><TD ALIGN="LEFT">||</TD><TD ALIGN="LEFT">exactly one (1,1)</TD></TR><TR><TD ALIGN="LEFT">o|</TD><TD ALIGN="LEFT">zero or one (0,1)</TD></TR><TR><TD ALIGN="LEFT">|&lt;</TD><TD ALIGN="LEFT">one or many (1,N)</TD></TR><TR><TD ALIGN="LEFT">o&lt;</TD><TD ALIGN="LEFT">zero or many (0,N)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">PK primary key, FK foreign key, UQ unique</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">ROOM-AMENITY and RESERVATION-ROOM are the<BR ALIGN="LEFT"/>associative entities of two N:N relationships</FONT></TD></TR></TABLE>>];
}
